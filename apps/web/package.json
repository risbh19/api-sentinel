    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "playwright-core": "1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
